# Copy to apps/api/.env. Everything here is read by the API, the migration and
# the seed; anything already exported in the shell wins over this file.

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Required ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/snapx
REDIS_URL=redis://localhost:6379

# Two different secrets, 32+ characters each. The process refuses to start on a
# placeholder, so generate real ones — run this twice:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

# --- Media storage ---
# Local disk is the development default and does not survive a redeploy. With
# S3 configured the same signed-URL contract is served by the bucket instead.
STORAGE_DIR=./storage
# S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
# CDN_BASE_URL=

# --- Calls ---
# Without TURN, calls fail on roughly 10–20% of real networks (deploy/coturn.conf).
# TURN_URL=turns:turn.example.com:5349
# TURN_SECRET=            # ephemeral credentials, derived per user — preferred
# TURN_USERNAME=          # static credentials, only if the server cannot do the above
# TURN_CREDENTIAL=
# TURN_TTL_SEC=86400
# STUN_URLS=stun:stun.l.google.com:19302

# --- Outbound delivery (password reset) ---
# With neither set, codes are not delivered and the API logs the recipient only
# (never the code). Under NODE_ENV=test they go to an in-memory outbox that the
# suite reads from /api/test/outbox — that route exists only in test.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=SNAPX <no-reply@example.com>
# SMS_PROVIDER=

# --- Telemetry (optional) ---
# NEXT_PUBLIC_ANALYTICS_URL=https://telemetry.example.com/events
